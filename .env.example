# Copy this file to .env for local development. Never commit .env or real secrets.
# Neon: Project -> Connect -> copy the connection string.
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require"

# Canonical HTTPS origin used in emailed links. Azure must set this explicitly.
PUBLIC_BASE_URL="https://YOUR_APP.azurewebsites.net"
# Generate a long random value, for example: py -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=""
# Set to 1 when local traffic is HTTPS; Azure enables secure cookies automatically.
SESSION_COOKIE_SECURE="0"

# Separate Microsoft identity app that supports personal Microsoft accounts.
OUTLOOK_CLIENT_ID="YOUR_OUTLOOK_APP_CLIENT_ID"
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_AUTHORITY="https://login.microsoftonline.com/consumers"
OUTLOOK_REDIRECT_URI="https://YOUR_APP.azurewebsites.net/integrations/outlook/callback"
OUTLOOK_SENDER_EMAIL="jinxhsdrecruiting@outlook.com"
# Generate with: py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTLOOK_TOKEN_ENCRYPTION_KEY=""
# One-time intake links expire after 1-30 days.
INTAKE_INVITATION_DAYS="14"

# Used only by the one-time load_programs.py catalog refresh command.
COLLEGE_SCORECARD_API_KEY=""
