# Copy this file to .env and paste your real Neon connection string below.
# The .env file is git-ignored so your database password is never committed.
#
# In the Neon console: open your project -> Connect -> copy the connection string.
# It will look like the example below (with your own host, user, and password).

DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require"
